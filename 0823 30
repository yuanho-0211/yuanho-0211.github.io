#include<iostream>
#include<vector>
using namespace std;
int main()
{
	int t,n,p;
	cin>>t;
	while(t--)
	{
		cin>>n;
		cin>>p;
		int r=0;
		vector<int>v(p);
		for(int i=0;i< p;i++)
		{
			cin>>v[i];
		}
		for(int i=1;i<=n ;i++)
		{
			if(i%7==0||i%7==6)
			 {
				 continue;
			 }
		
			for(int j=0;j<p ;j++)
			{
				if(i%v[j]==0)
				{
					r++;
					break;
				}
			}
		}
		cout<<r<<endl;
	}
}
		