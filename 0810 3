#include<iostream>
using namespace std;
int main()
{
	int a,b;
	while(cin>>a>>b)
	{
		int d=0;
	
		if(a==0&&b==0)
		{
			break;
		}
		int c=0;
		while(a>0||b>0)
		{
			if((a%10+b%10+c)>9)
			{
				c=1;
				d++;
			}
			else
			{
				c=0;
			}
			a=a/10;
			b=b/10;
			
		}
		if(d==0)
		{
			cout<<"No carry operation."<<endl;
		}
		else if(d==1)
		{
			cout<<"1 carry operation."<<endl;
		}
		else
		{
			cout<<d<<" carry operations."<<endl;
		
		}
	}
}