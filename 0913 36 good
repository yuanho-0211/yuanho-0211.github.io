#include<iostream>
#include<vector>
using namespace std;
int main()
{
	int t,m,n,q;
	int r,c;
	cin>>t;
	int o;
	while(t--)
	{
		cin>>m>>n>>q;
		vector <string> v(m);
		for(int i=0;i<m ;i++)
		{
			cin>>v[i];
		}
		int y=q;
		cout<<m<<" "<<n<<" "<<y<<endl;
		while(q--)
		{
			
		    o=1;
			cin>>r>>c;
			bool b=false;
			bool e=false;
			while(!b)
			{
				for(int i=r-o;i<=r+o ;i++)
			   {
				   for(int j=c-o;j<=c+o ;j++)
				   {
					  if(i<0||j<0||i>=m||j>=n)
					  {
					  	   b=true;
						   e=true;
						   break;
					  }
					  if(v[i][j]!=v[r][c])
					  {
					  	   b=true;
						   e=true;
						   break;
					  }
				   }
				   if(e)
				   {
				   	  break;
				   }
			   }
			   if(!b)
			   {
			   	  o++;
			   }
			}
			cout<<2*o-1<<endl;
	   }
	}
}