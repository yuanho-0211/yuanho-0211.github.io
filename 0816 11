#include<iostream>
using namespace std;
int main()
{
	string a,b;
	while(cin>>a>>b)
	{
		int c[26]={0};
		int d[26]={0};
		for(int i=0;i< a.size();i++)
		{
			c[(a[i]-'a')]++;
		}
		for(int i=0;i< b.size();i++)
		{
			d[(b[i]-'a')]++;
		}
		for(int i=0;i<26 ;i++)
		{
			int t=min(c[i],d[i]);
			if(t>0)
			{
				for(int j=0;j< t;j++)
				{
					cout<<char(i+'a');
				}
			}
		}
		cout<<endl;
	}
}