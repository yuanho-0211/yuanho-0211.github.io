#include<iostream>
#include<string>
using namespace std;
int main()
{
	string s;
	while(cin>>s)
	{
		int a[256];
		int m=0;
		for(int i=0;i<s.size() ;i++)
		{
			a[int(s[i])]++;
		}
		for(int i=0;i<256 ;i++)
		{
			if(a[i]>m)
			{
				m=a[i];
			}
		}
		for(int i=1;i<=m;i++)
	    {
			for(int j=255;j>=0 ;j--)
			{
				if(a[j]==i)
				{
					cout<<j<<" "<<a[j]<<endl;
				}
			}
		}
		cout<<endl;
	}
}