#include<iostream>
#include<algorithm>
#include<vector>
using namespace std;
int main()
{
	int t;
	while(cin>>t)
	{
		vector <int>v(t);
	
		for(int i=0;i<t ;i++)
		{
			cin>>v[i];
		}
		sort(v.begin(),v.end());
		int a,b;
		int u=0;
		if(t%2==1)
		{
			a=v[t/2];
			b=1;
		
		   for(int i=0;i<t ;i++)
		   {
			   if(v[i]==a)
			   {
				   u++;
			   }
		   }
		}
		else
		{
			a=v[t/2-1];
			b=v[t/2]-a+1;
			for(int i=0;i<t ;i++)
		   {
			   if(v[i]>=a&&v[i]<=v[t/2])
			   {
				   u++;
			   }
		   }
		}
		cout<<a<<" "<<u<<" "<<b<<endl;
	}
}