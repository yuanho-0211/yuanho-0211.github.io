#include<iostream>
#include<string>
using namespace std;
int main()
{
	string s;
	int t=0;
	while(getline(cin,s))
	{
		for(int i=0;i< s.size();i++)
		{
			if(s[i]=='"')
			{
				if(t%2==0)
				{
					cout<<"``";
				}
				else
				{
					cout<<"''";
				}
				t++;
				continue;
			}
			cout<<s[i];
		
		}
		cout<<endl;
	}
}