#include<iostream>
#include<algorithm>
#include<cctype>
#include <string>
using namespace std;
int main()
{
	int t;
	string s;
	char c[26];
	int a[26]={0};
	
	cin>>t;
	cin.ignore();
	for(int i=0;i<26;i++)
	{
		c[i]=i+'A';
	}
	while(t--)
	{
		getline(cin,s);
		for(int i=0;i<s.size();i++)
		{
			if(isalpha(s[i]))
			{
				s[i]=toupper(s[i]);
				a[(s[i]-'A')]++;
			}
		}
	}
	for(int i=0;i<26;i++)
	{
		for(int j=i+1;j<26;j++)
		{
			if(a[i]<a[j]||(a[i]==a[j]&&c[i]>c[j]))
			{
				swap(a[i],a[j]);
				swap(c[i],c[j]);
			}
		}
	}
	for(int i=0;i<26;i++)
	{
		if(a[i]>0)
		{
			cout<<c[i]<<" "<<a[i]<<endl;
		}
	}
}