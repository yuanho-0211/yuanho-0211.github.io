#include<iostream>
#include<string>
using namespace std;
int main()
{
	string s;
	while(cin>>s)
	{
		int c=0;
	    int d=0;
		if(s=="0")
		{
			break;
		}
		int a=s.size();
		for(int i=0;i<a;i++)
		{
			if(i%2==0)
			{
				c=c+(s[i]-'0');
			}
			else
			{
				d=d+(s[i]-'0');
			}
		}
		if(abs(c-d)%11==0)
		{
			cout<<s<<" is a multiple of 11."<<endl;
		}
		
		else
		{
			cout<<s<<" is not a multiple of 11."<<endl;
		}
	}
}