#include <iostream>
#include <algorithm>
#include <vector>
using namespace std;
int main()
{
   int n,m;
   while(cin>>n>>m)
   {
       if(n==0&&m==0)
       {
           break;
       }
       vector <int> a(n+1);
       vector <int> b(n+1);
       for(int i=1;i<n+1;i++)
       {
           cin>>a[i];
           b[i]=a[i];
           a[i]=a[i]%m;
       }
       for(int i=1;i<=n;i++)
       {
           for(int j=1;j<=n-1;j++)
          {
              if(a[j]>a[j+1])
              {
                  swap(a[j],a[j+1]);
                  swap(b[j],b[j+1]);
              }
              else if(a[j]==a[j+1])
              {
                  if(b[j]%2==0&&b[j+1]%2==1)
                  {
                      swap(a[j],a[j+1]);
                      swap(b[j],b[j+1]);
                  }
                  else if(b[j]%2==1&&b[j+1]%2==1&&b[j]<b[j+1])
                  {
                      swap(a[j],a[j+1]);
                      swap(b[j],b[j+1]);
                  }
                  else if(b[j]%2==0&&b[j+1]%2==0&&b[j]>b[j+1])
                  {
                      swap(a[j],a[j+1]);
                      swap(b[j],b[j+1]);
                  }
              }
          }
       }
       cout<<n<<" "<<m<<endl;
       for(int i=1;i<n+1;i++)
       {
           cout<<b[i]<<endl;
       }
   }
   cout<<"0 0";
}
