#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
	int t;
	cin>>t;
	while(t--)
	{
		int a;
		cin>>a;
		vector <int> v(a);
		for(int i=0;i<a ;i++)
		{
			cin>>v[i];
		}
		int b=0;
		for(int i=0;i<a-1 ;i++)
		{
			for(int j=0;j< a-i-1;j++)
			{
				if(v[j]>v[j+1])
				{
					swap(v[j],v[j+1]);
					b++;
				}
			}
		}
		cout<<"Optimal train swapping takes "<<b<<" swaps."<<endl;
	}
}