#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
	int n;
	int m;
	
	cin>>n;
	while(n--)
	{
		cin>>m;
		vector <int> v(m);
		for(int i=0;i<m;i++)
		{
			cin>>v[i];
		}
		sort(v.begin(),v.end());
		int a=v[m/2];
		int b=0;
		for(int i=0;i<m;i++)
		{
			b=b+abs(v[i]-a);
		}
		cout<<b<<endl;
	}
}