		ss>>g;
		v[u]=g;
		u++;
	}
	int y;
	int r;
	sort(v.begin(),v.end());
	for(int i=0;i< u;i++)
	{
		y=1;
		if(i+1<u)
		{
		  while(i+1<u&&v[i]==v[i+1])
		  { 
			 y++;
			 i++;
		  }
		}
		cout<<v[i]<<" "<<y<<endl;
		
	}
}