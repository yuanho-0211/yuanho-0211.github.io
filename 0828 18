#include<iostream>
#include<string>
#include<sstream>
#include<cmath>
using namespace std;
#include<vector>
int main()
{
	int x;
	string s;
	while(cin>>x)
	{
		cin.ignore();
		getline(cin,s);
       stringstream w(s);
		int a;
		vector<int> v;
		int n=0;
		//while(cin>>a)
		while(w>>a)
		{
			v.push_back(a);
			n++;
		}
		int d=n-1;
		int t=0;
		for(int i=0;i<v.size() -1;i++)
		{
			d--;
			n--;
			t=t+v[i]*n*pow(x,d);
		}
		cout<<t<<endl;
	}
}