#include<iostream>
#include<cmath>
using namespace std;
#include<vector>
int main()
{
	int x;
	while(cin>>x)
	{
		int a;
		vector<int> v;
		int n=0;
		while(cin>>a)
		{
			v.push_back(a);
			n++;
		}
		int d=n;
		int t=0;
		n=n+1;
		for(int i=0;i<v.size() ;i++)
		{
			d--;
			n--;
			t=t+v[i]*n*pow(x,d);
		}
		cout<<t<<endl;
	}
}