#include<iostream>
using namespace std;
#include<vector>
int main()
{
	int n;
	while(cin>>n)
	{
		vector <int> v(n,0);
		vector <int> a(n);
		bool b=false;
		for(int i=0;i<n ;i++)
		{
			cin>>a[i];
		}
		for(int i=0;i<n ;i++)
		{
			if(i+1<n)
			{
				if(abs(a[i]-a[i+1])>0&&abs(a[i]-a[i+1])<n)
				{
				  v[abs(a[i]-a[i+1])]=1;
				}
				else
				{
					b=true;
					//break;
				}
			
			}
		}
		for(int i=1;i<n ;i++)
		{
			if(v[i]==0)
			{
				b=true;
				break;
			}
		}
		if(b)
		{
			cout<<"Not jolly"<<endl;
			//break;
		}
		else
		{
		    cout<<"Jolly"<<endl;
		}
	}
}