#include<iostream>
#include<vector>
using namespace std;
int main()
{
	int a,b;
	int t=0;
	while(cin>>a>>b)
	{
		t++;
		if(a==0&&b==0)
		{
			break;
		}
		vector <string> m(a);
		//vector <string> n(a);
		vector <string> n(a,string(b,'.'));
		for(int i=0;i<a ;i++)
		{
			cin>>m[i];
		}
		int x[8]={-1,0,1,-1,1,-1,0,1};
		int y[8]={1,1,1,0,0,-1,-1,-1};
		for(int i=0;i<a ;i++)
		{
			for(int j=0;j< b;j++)
			{
				if(m[i][j]=='*')
				{
					n[i][j]='*';
					continue;
				}
				int u=0;
				for(int k=0;k<8 ;k++)
				{
					if(i+y[k]>=0&&i+y[k]<a&&j+x[k]>=0&&j+x[k]<b)
					{
						if(m[i+y[k]][j+x[k]]=='*')
						{
							u++;
						}
					}
				}
				//n[i][j]=u;
				n[i][j]=u+'0';
			}
		}
		cout<<"Field #"<<t<<":"<<endl;
		for(int i=0;i< a;i++)
		{
			cout<<n[i]<<endl;
		}
		cout<<endl;
		
	}
}
